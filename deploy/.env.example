# 成长星球·科学班生态 —— 环境变量样例
# 复制为 .env 后修改

# 后端
PORT=3100
DB_HOST=umami-db
DB_PORT=5432
DB_NAME=growth_planet
DB_USER=gp_app
DB_PASSWORD=请改成强密码
JWT_SECRET=请改成随机长串-可用 openssl rand -hex 32 生成
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_IN=30d

# 前端可访问的 API 基址（部署后填域名）
# 本地原型阶段留空，走 localStorage
API_BASE=https://你的域名
