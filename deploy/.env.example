# 成长星球·科学班生态 —— 环境变量样例
# 复制为 deploy/.env 后修改（密钥绝不进 Git）

# 数据库（gp-db 容器会自动用这些值建库建用户）
DB_PASSWORD=请改成强密码
DB_HOST=gp-db
DB_PORT=5432
DB_NAME=growth_planet
DB_USER=gp_app

# 后端
PORT=3100
NODE_ENV=production
JWT_SECRET=请改成随机长串-可用 openssl rand -hex 32 生成
JWT_EXPIRES_IN=30d          # 老师端低频登录，单 token 即可，不做 refresh
ALLOW_REGISTER=false        # 生产关闭公开注册，用 create-teacher.js 建号
LOG_LEVEL=info

# 前端页面里 window.GP_API_BASE 填这里的值（部署后填域名，例如 https://gp.你的域名）
# 留空则前端纯本地运行，数据只存浏览器
API_BASE=
